{
  "expo": {
    "name": "NHNK",
    "slug": "nhnk-ios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nhnk",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/32a26541-e8d4-4bf7-9d26-f26a8ea313e1"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "hu.bmx.nhnk",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "NHNK",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "hu",
          "en",
          "de"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "locales": {
      "hu": "./locales/hu.json",
      "en": "./locales/en.json",
      "de": "./locales/de.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/nhnk-logo.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Az NHNK a Face ID-val oldja fel az alkalmazást."
        }
      ],
      "expo-web-browser",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#6C8F96"
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Az NHNK csak a kiválasztott képeket csatolja a számonkérésekhez.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "32a26541-e8d4-4bf7-9d26-f26a8ea313e1"
      }
    },
    "owner": "bmx"
  }
}